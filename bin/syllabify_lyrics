#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_PY="$ROOT/env/bin/python"

if [[ ! -x "$VENV_PY" ]]; then
  echo "Missing env/ virtual environment. Follow requirements/README.md to create it and install dependencies." >&2
  exit 1
fi

exec "$VENV_PY" "$ROOT/.agents/skills/syllabify_lyrics/scripts/syllabify_lyrics.py" "$@"
